{
  "name": "muli",
  "version": "1.0.1",
  "description": "Desktop companion app for Mole — clean your Mac without touching the terminal",
  "main": "electron/main.js",
  "scripts": {
    "dev:ui": "cd ui && npm run dev",
    "dev:electron": "electron electron/main.js",
    "dev": "concurrently \"npm run dev:ui\" \"wait-on http://localhost:3000 && npm run dev:electron\"",
    "build:ui": "cd ui && npm run build",
    "dist:mac": "npm run build:ui && electron-builder --mac",
    "release": "./scripts/release.sh",
    "deploy:landing": "./scripts/release.sh --landing-only",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "keywords": [
    "macos",
    "cleaner",
    "mole",
    "electron"
  ],
  "author": "Alby Technology <albyteknologi@gmail.com>",
  "license": "ISC",
  "build": {
    "appId": "com.albyteknologi.muli",
    "productName": "Muli",
    "artifactName": "${productName}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "ui/.output/public/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "npmRebuild": true,
    "afterPack": "scripts/adhoc-sign.js",
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "concurrently": "^9.2.1",
    "electron": "^40.2.1",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "electron-serve": "^1.3.0",
    "node-pty": "^1.1.0",
    "strip-ansi": "^7.1.2"
  }
}
